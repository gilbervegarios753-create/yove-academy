# ===================================================================
# YOVE ACADEMY 3.0 — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT ACTUAL SECRETS OR KEYS TO VERSION CONTROL.
# ===================================================================

# Server Runtime Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (SQLite File Path or Cloud Relational DB)
# Default: ./data/yove_academy.db
DATABASE_PATH=./data/yove_academy.db
DATABASE_URL=file:./data/yove_academy.db

# Authentication & Session Security
# Generate a cryptographically strong 64-character secret (e.g. `openssl rand -hex 32`)
SESSION_SECRET=your-production-session-secret-change-this-in-prod

# Google Gemini AI Model Integration
# Server-side API Key for YOVE AI Diagnostics (never expose to client)
GEMINI_API_KEY=your-google-gemini-api-key-here

# Monetization & Payments (Stripe)
# Public key for frontend client
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
# Secret key for server-side payment processing
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# Webhook secret for verifying Stripe event signatures
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Transactional Email Provider (SMTP / SendGrid / Mailgun)
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=notifications@yoveacademy.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="YOVE Academy <no-reply@yoveacademy.com>"

# Storage Driver for User Attachments, Certificates & Media
# Options: local | gcs | s3
STORAGE_DRIVER=local
STORAGE_BUCKET_NAME=yove-academy-media-prod

# CORS Security & Trusted Origins
CORS_ORIGIN=https://yoveacademy.com,https://www.yoveacademy.com

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
